GEMINI_API_KEY=<your_gemini_api_key>
SBERT_MODEL_NAME=all-mpnet-base-v2
SPACY_MODEL_NAME=en_core_web_sm
HF_TOKEN=<your_huggingface_token>   # optional

# LLM runtime defaults
llm_temperature=0.0
llm_timeout_seconds=270
# Fixed sleep between API calls when enable_sleep=true in YAML.
llm_sleep_seconds=1.0
# Number of retries after the first failed attempt.
llm_max_retries=3
# Exponential backoff initial delay (seconds).
llm_backoff_initial_seconds=2.0
# Exponential backoff multiplier.
llm_backoff_multiplier=2.0
# Exponential backoff maximum delay (seconds).
llm_backoff_max_seconds=32.0
# Retryable HTTP status codes (comma-separated).
llm_retry_http_statuses=429,500,502,503,504
